# AI Service (FastAPI) Environment Configuration
PROJECT_NAME="CS Scholar AI Engine"
APP_ENV=development
API_V1_PREFIX="/api/v1"
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cs_scholar_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO Connection
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKET=cs-scholar-documents

# Embedding & pgvector (Phase 4)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_VERSION=bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_SEQUENCE_LENGTH=512

# Hybrid Retrieval & Reranker (Phase 5)
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=16
RERANKER_TOP_K=10
DENSE_CANDIDATE_COUNT=40
KEYWORD_CANDIDATE_COUNT=40
HYBRID_CANDIDATE_COUNT=40
RRF_K=60
QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 

# LLM Providers (Placeholders for Future Phases)
GROQ_API_KEY=gsk_placeholder_groq_api_key
GEMINI_API_KEY=placeholder_gemini_api_key

