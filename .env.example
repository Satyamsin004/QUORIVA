# ==============================================================================
# CS SCHOLAR AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL (with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_DB=cs_scholar_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ------------------------------------------------------------------------------
# Redis Cache & Message Broker
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Local Object Storage
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKETS=cs-scholar-documents
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# ------------------------------------------------------------------------------
# S3 / Object Storage Configuration
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=cs-scholar-documents
S3_PATH_STYLE_ACCESS=true
S3_PRESIGNED_URL_EXPIRATION_SECONDS=900
DOCUMENT_MAX_FILE_SIZE_BYTES=52428800

# ------------------------------------------------------------------------------
# Spring Boot Main Backend
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Python FastAPI AI Service
# ------------------------------------------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# Security & Internal Service Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_256_bit_secret_key_in_production
JWT_EXPIRATION_MS=86400000
INTERNAL_SERVICE_KEY=cs_scholar_internal_service_secret_key_change_in_production

# ------------------------------------------------------------------------------
# Celery & Background Worker Configuration
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# Document Ingestion & Chunking Configuration
# ------------------------------------------------------------------------------
TARGET_CHUNK_SIZE=600
CHUNK_OVERLAP=90
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=800
OCR_ENABLED=false
MAX_OCR_PAGES=20
MAX_PDF_PAGES=500
TESSERACT_CMD=tesseract

# ------------------------------------------------------------------------------
# Embedding Model & pgvector Configuration (Phase 4)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_MODEL_VERSION=bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto
EMBEDDING_MAX_SEQUENCE_LENGTH=512

# ------------------------------------------------------------------------------
# Hybrid Retrieval & Reranker Configuration (Phase 5)
# ------------------------------------------------------------------------------
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=16
RERANKER_TOP_K=10
DENSE_CANDIDATE_COUNT=40
KEYWORD_CANDIDATE_COUNT=40
HYBRID_CANDIDATE_COUNT=40
RRF_K=60
QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 

# ------------------------------------------------------------------------------
# AI Provider Keys & Academic Tutor RAG (Phase 6)
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_placeholder_groq_api_key
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GEMINI_API_KEY=placeholder_gemini_api_key
GEMINI_MODEL_NAME=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
RAG_MAX_CONTEXT_TOKENS=4000
RAG_MAX_RETRIEVED_CHUNKS=8
RAG_HISTORY_MAX_MESSAGES=8


